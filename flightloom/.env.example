# Token de API de Travelpayouts (https://www.travelpayouts.com/programs/100/api)
TRAVELPAYOUTS_TOKEN=your_token_here

# Marker de afiliado de Travelpayouts (identifica tu cuenta en los enlaces de reserva
# para que las comisiones se te asignen a ti)
TRAVELPAYOUTS_MARKER=your_marker_here

# Puerto del servidor
PORT=3000

# Moneda por defecto para mostrar precios
DEFAULT_CURRENCY=EUR

# TTL de caché en segundos
CALENDAR_CACHE_TTL=21600
DESTINATIONS_CACHE_TTL=43200

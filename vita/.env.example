# ── Postgres / TimescaleDB ───────────────────────────────────────────────
POSTGRES_USER=vita
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vita
# Used by apps/web y apps/worker. Dentro de docker-compose el host es "db";
# en desarrollo local fuera de Docker usa "localhost".
DATABASE_URL=postgres://vita:change-me@localhost:5432/vita

# ── Autenticación (usuario único) ───────────────────────────────────────
# Email del único usuario de la app (solo para identificarlo, no se usa
# para enviar nada por defecto).
AUTH_USER_EMAIL=enricochavomartin@gmail.com
# Hash bcrypt de la contraseña. Generar con:
#   node vita/scripts/hash-password.mjs "tu-contraseña"
AUTH_PASSWORD_HASH=
# Secreto para firmar la cookie de sesión (JWT). Generar con:
#   openssl rand -hex 32
AUTH_SECRET=
# Duración de la sesión en días (sesión larga, un solo usuario)
AUTH_SESSION_DAYS=90

# ── Cifrado de credenciales de integraciones (tabla `integrations`) ─────
# Clave AES-256 en hex (32 bytes = 64 caracteres hex). Generar con:
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=

# ── Claude Agent SDK ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo por agente (Fase 1). Director y Doctor usan el modelo más capaz;
# Nutrición/Métricas/Deporte usan uno intermedio; tareas mecánicas, uno económico.
AGENT_DIRECTOR_MODEL=claude-opus-5-5
AGENT_DOCTOR_MODEL=claude-opus-5-5
AGENT_NUTRITION_MODEL=claude-sonnet-5
AGENT_METRICS_MODEL=claude-sonnet-5
AGENT_SPORT_MODEL=claude-sonnet-5
AGENT_UTILITY_MODEL=claude-haiku-4-5-20251001
# Límite de gasto mensual en USD (control de coste, ver docs/fase-0.md)
AGENT_MONTHLY_BUDGET_USD=30

# ── Strava (Fase 3) ──────────────────────────────────────────────────────
# App creada en https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Token propio (inventado por ti) para validar los webhooks de Strava.
# Generar con: openssl rand -hex 16
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ── Google Health API (sucesora de Fitbit Web API, Fase 3) ──────────────
# Ver knowledge/integraciones/fitbit-estado-api.md. Proyecto en Google
# Cloud Console, pantalla de consentimiento OAuth en modo "Testing".
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# ── Email (informes, Fase 5) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=enricochavomartin@gmail.com

# ── Apps ─────────────────────────────────────────────────────────────────
NODE_ENV=development
WEB_PORT=3000
